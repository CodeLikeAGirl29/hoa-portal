# Copy this file to .env and fill in the values.

# PostgreSQL connection string. For a hosted database (Neon, Supabase, Vercel
# Postgres) use the URL the provider gives you, ending in ?sslmode=verify-full
DATABASE_URL="postgresql://user:password@localhost:5432/hoa_portal?schema=public"

# Max connections each server instance may open (default 5).
# DATABASE_POOL_MAX=5

# NextAuth — generate the secret with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Optional: email notifications through Resend (https://resend.com)
# RESEND_API_KEY=""
# FROM_EMAIL="noreply@yourdomain.com"

# Optional: set to "true" in Vercel so each deploy adds any missing demo
# communities, accounts and documents. Leave unset for a real community.
# SEED_DEMO_DATA="true"
